-- Lost & Found schema (PostgreSQL). Safe to run on every startup.
-- IDs are UUID strings generated by the app (varchar(36)), so the API/JWT ids stay plain strings.

CREATE TABLE IF NOT EXISTS users (
    id          VARCHAR(36)  PRIMARY KEY,
    first_name  VARCHAR(255) NOT NULL,
    last_name   VARCHAR(255) NOT NULL,
    student_id  INTEGER      UNIQUE,                 -- NULL allowed (staff); many NULLs are fine
    email       VARCHAR(255) NOT NULL UNIQUE,
    phone_num   VARCHAR(255) NOT NULL UNIQUE,
    password    VARCHAR(255) NOT NULL,
    role        VARCHAR(20)  NOT NULL CHECK (role IN ('Student','Moderator','Admin')),
    created_at  TIMESTAMPTZ
);

CREATE TABLE IF NOT EXISTS categories (
    id    VARCHAR(36)  PRIMARY KEY,
    name  VARCHAR(255) NOT NULL UNIQUE,
    icon  VARCHAR(255) NOT NULL
);
CREATE UNIQUE INDEX IF NOT EXISTS ux_categories_name_lower ON categories (lower(name));

CREATE TABLE IF NOT EXISTS drop_locations (
    id       VARCHAR(36)  PRIMARY KEY,
    name     VARCHAR(255) NOT NULL,
    contact  VARCHAR(255) NOT NULL
);
CREATE UNIQUE INDEX IF NOT EXISTS ux_drop_locations_name_lower ON drop_locations (lower(name));

CREATE TABLE IF NOT EXISTS items (
    id                   VARCHAR(36)  PRIMARY KEY,
    reporter_id          VARCHAR(36)  REFERENCES users(id),
    name                 VARCHAR(255) NOT NULL,
    type                 VARCHAR(10)  NOT NULL CHECK (type IN ('LOST','FOUND')),
    description          TEXT         NOT NULL,
    category_id          VARCHAR(36)  REFERENCES categories(id),
    color                VARCHAR(255) NOT NULL,
    brand                VARCHAR(255) NOT NULL,
    distinguishing_marks TEXT         NOT NULL,       -- never exposed publicly
    location_name        VARCHAR(255) NOT NULL,
    drop_location_id     VARCHAR(36)  REFERENCES drop_locations(id),
    date_occurred        DATE,
    status               VARCHAR(10)  NOT NULL DEFAULT 'OPEN'
                         CHECK (status IN ('OPEN','MATCHED','CLAIMED','CLOSED','EXPIRED')),
    created_at           TIMESTAMPTZ,
    updated_at           TIMESTAMPTZ,
    -- full-text search over name (weight A) and description (weight B); replaces Mongo's text index
    search_vector        TSVECTOR GENERATED ALWAYS AS (
                             setweight(to_tsvector('english', coalesce(name, '')), 'A') ||
                             setweight(to_tsvector('english', coalesce(description, '')), 'B')
                         ) STORED
);
CREATE INDEX IF NOT EXISTS ix_items_reporter      ON items (reporter_id);
CREATE INDEX IF NOT EXISTS ix_items_type          ON items (type);
CREATE INDEX IF NOT EXISTS ix_items_category      ON items (category_id);
CREATE INDEX IF NOT EXISTS ix_items_drop_location ON items (drop_location_id);
CREATE INDEX IF NOT EXISTS ix_items_status_created ON items (status, created_at DESC);
CREATE INDEX IF NOT EXISTS ix_items_search        ON items USING GIN (search_vector);

CREATE TABLE IF NOT EXISTS item_images (
    item_id    VARCHAR(36)  NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    url        VARCHAR(1024),
    public_id  VARCHAR(255),   -- Cloudinary id, never sent to clients
    position   INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS ix_item_images_item ON item_images (item_id);

CREATE TABLE IF NOT EXISTS claims (
    id                    VARCHAR(36)  PRIMARY KEY,
    item_id               VARCHAR(36)  REFERENCES items(id) ON DELETE CASCADE,
    claimant_id           VARCHAR(36)  REFERENCES users(id),
    proof_description     TEXT         NOT NULL,
    proof_image_url       VARCHAR(1024) NOT NULL,
    proof_image_public_id VARCHAR(255),
    status                VARCHAR(10)  NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','APPROVED','REJECTED')),
    review_note           TEXT,
    reviewed_at           TIMESTAMPTZ,
    reviewed_by           VARCHAR(36)  REFERENCES users(id),
    created_at            TIMESTAMPTZ
);
CREATE INDEX IF NOT EXISTS ix_claims_item     ON claims (item_id);
CREATE INDEX IF NOT EXISTS ix_claims_claimant ON claims (claimant_id, created_at DESC);

CREATE TABLE IF NOT EXISTS matches (
    id             VARCHAR(36) PRIMARY KEY,
    lost_item_id   VARCHAR(36) REFERENCES items(id) ON DELETE CASCADE,
    found_item_id  VARCHAR(36) REFERENCES items(id) ON DELETE CASCADE,
    score          DOUBLE PRECISION NOT NULL,
    status         VARCHAR(10) NOT NULL DEFAULT 'SUGGESTED' CHECK (status IN ('SUGGESTED','CONFIRMED','DISMISSED')),
    created_at     TIMESTAMPTZ
);
CREATE INDEX IF NOT EXISTS ix_matches_lost  ON matches (lost_item_id);
CREATE INDEX IF NOT EXISTS ix_matches_found ON matches (found_item_id);

CREATE TABLE IF NOT EXISTS messages (
    id           VARCHAR(36) PRIMARY KEY,
    item_id      VARCHAR(36) REFERENCES items(id) ON DELETE CASCADE,
    sender_id    VARCHAR(36) REFERENCES users(id),
    receiver_id  VARCHAR(36) REFERENCES users(id),
    body         TEXT,
    read_at      TIMESTAMPTZ,
    created_at   TIMESTAMPTZ
);
CREATE INDEX IF NOT EXISTS ix_messages_item     ON messages (item_id);
CREATE INDEX IF NOT EXISTS ix_messages_receiver ON messages (receiver_id);

CREATE TABLE IF NOT EXISTS notifications (
    id          VARCHAR(36) PRIMARY KEY,
    user_id     VARCHAR(36) REFERENCES users(id),
    type        VARCHAR(20) CHECK (type IN ('MATCH_FOUND','CLAIM_UPDATE','NEW_MESSAGE')),
    payload     JSONB,                              -- free-form, e.g. {"itemId": "...", "matchId": "..."}
    is_read     BOOLEAN NOT NULL DEFAULT FALSE,
    created_at  TIMESTAMPTZ
);
CREATE INDEX IF NOT EXISTS ix_notifications_user ON notifications (user_id);